{
  "name": "butterfly-desktop",
  "version": "1.0.0",
  "description": "Butterfly Desktop Companion App for Discord Rich Presence",
  "main": "src/main.js",
  "type": "module",
  "author": "Butterfly",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "dist": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.butterfly.desktop",
    "productName": "Butterfly",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "!src/debug.log",
      "!src/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "publisherName": "Butterfly"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Butterfly"
    },
    "portable": {
      "artifactName": "Butterfly-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "discord-rpc": "^4.0.1"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^25.1.8"
  }
}
